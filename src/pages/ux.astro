---
// The Work screen, inside the portfolio's own system: the same painting
// backdrop, type and nav as the homepage and the playground, so the UX door
// leads into the same house. Project copy comes from src/content/projects.
import { getCollection } from 'astro:content';
import PortfolioBackdrop from '../components/PortfolioBackdrop.astro';
import PortfolioPolish from '../components/PortfolioPolish.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteHead from '../components/SiteHead.astro';
import '../styles/portfolio-v2.css';
import '../styles/portfolio-chrome.css';
import '../styles/portfolio-case.css';

// Shared with the homepage, playground and case studies.
import { HOME, RESUME } from '../data/siteNav';

const projects = await getCollection('projects');
const bySlug = (slug) => projects.find((project) => project.data.slug === slug)?.data;

const selectedSlugs = ['earth-hero', 'letter-river', 'idl'];
const selected = selectedSlugs.map(bySlug).filter(Boolean);
const labels = {
  'earth-hero': 'Client work · Tech Fleet',
  'letter-river': 'Independent prototype',
  idl: 'Professional design engineering',
};

// Each piece takes the shape its own evidence wants, rather than all three
// repeating one card. Three identical modules in a row is the thing that reads
// as a template no matter how good the type is.
//
//   letter-river  a real screenshot of the running app, run full width under
//                 the writing
//   idl           a photograph of the actual store drawings beside the real
//                 before/after numbers: two artefacts, no mockup
//   ai-archiving  a concept with nothing built, so its own documented flow is
//                 the visual and it runs the full width
//
// Everything here is real material. public/images/ai-archiver.png is an
// AI-generated picture of an interface — its labels read "ALASSISTANT",
// "Confience level", "game wirning point" — so it is deliberately not used:
// a generated screenshot presented as prototype work is the fastest way to
// lose a reviewer's trust.
const visuals = {
  'earth-hero': {
    layout: 'diagram',
    steps: {
      eyebrow: 'The loop',
      title: 'Quest, action, points, team',
      steps: [
        { title: 'Choose a quest' },
        { title: 'Log a daily action' },
        { title: 'Earn Earth Points' },
        { title: 'Join a team' },
        { title: 'See where you stand' },
      ],
    },
  },
  'letter-river': {
    layout: 'media',
    src: '/images/derived/Desktop_Hero_Screen-1400.webp',
    alt: 'Letter River home screen: language pickers, a greeting, and the Bridge Builder lesson in progress',
  },
  idl: {
    layout: 'split',
    src: '/images/derived/idl-case-study-1400.webp',
    alt: 'Store drawings and fixture elevations spread across a desk',
    bars: bySlug('idl')?.caseStudy?.solution?.bars,
  },
};

// One sentence that makes a claim, in place of three bullets that were labels.
// Each is drawn from the case study's own copy, not invented here.
const claims = {
  'earth-hero': 'People who already care about their footprint still stop logging actions after a week, so the work was motivation design \u2014 and then a study written to check whether players read the mechanics the way we intended.',
  'letter-river': 'A learner who can name a letter still cannot hear it inside a word, so recognition, vocabulary and reading are one connected path rather than three separate drills.',
  idl: 'An eight-hour drawing, repeated across a national rollout, is a process problem rather than a drafting one \u2014 so the work was finding which parts of it could be made repeatable, and then being exact about which share of the gain was the team\u0027s and which was mine.',
};

// What the work actually produced. Every card used to bury this: Earth Hero's
// adoption sat at the end of the case study, Letter River had no outcome stated
// anywhere, and IDL's numbers were drawn in small grey bars at the bottom of
// the third card. It is the line a reviewer is scanning for, so it gets the
// same slot on all three.
//
// The second line is the honest qualifier in each case, not a second helping of
// praise. A result with its own limits attached is the more credible claim.
const outcomes = {
  'earth-hero': {
    value: 'Taken into the live app',
    note: 'Recommendations went to the client and Earth Hero took elements of the work into its product. The session findings belong to the engagement, not to me.',
  },
  'letter-river': {
    value: 'Built, and public',
    note: 'The prototype runs the whole path end to end and anyone can open it. Learning outcomes are unmeasured \u2014 the case study says so, and names the study that would settle it.',
  },
  idl: {
    value: '8 hours \u2192 37 minutes',
    note: 'Turnaround per store drawing. Eight hours down to two with the team; 37 minutes after I kept refining my own pass.',
  },
};

// Role, scope, dates. The three things a reviewer asks before reading anything
// else \u2014 and the place where a volunteer engagement and a staff job have to be
// told apart rather than flattened into one word.
const facts = {
  'earth-hero': ['UX Researcher & Product Designer', 'Cross-functional team, with a design partner', '2022\u20132026'],
  'letter-river': ['Designed and built it myself', 'Independent prototype', 'Self-directed'],
  idl: ['Design Engineer, on staff', 'Apple fixture rollout across AT&T retail', '2015\u20132017'],
};

// The hero promised and then proved nothing: the panel beside it restated the
// experience timeline further down the page. Three facts a reviewer can check
// against the case studies do more in five seconds than a paragraph does.
const proof = [
  { value: '8h \u2192 37min', label: 'Store-drawing turnaround, brought down over two stages at IDL Worldwide' },
  { value: '500+', label: 'AT&T retail locations digitized in SolidWorks for the Apple fixture rollout' },
  { value: 'Live product', label: 'Earth Hero took elements of the gamification work into its released app' },
];

const supporting = projects
  .filter((project) => !selectedSlugs.includes(project.data.slug))
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => project.data);

// Exploration thumbnails, where a real one exists. A card with no entry here
// is typed instead of filled, and says what state the work is in:
//   agora-21      the only image is a photograph of a text slide, not the work
//   ai-archiving  public/images/ai-archiver.png is an AI-generated picture of
//                 an interface, so it is deliberately not shown
//   bball         no interface capture in the repository
const thumbs = {
  rotogo: { src: '/images/derived/rotogoscreen-768.webp', fit: 'cover' },
};

const typeCardNote = {
  'agora-21': 'Concept \u00b7 not built',
  'ai-archiving': 'Concept \u00b7 prototype',
  bball: 'Personal project',
};

// Most recent first.
const experience = [
  { dates: '2023–2026', company: 'Active Learning Adventures', role: 'Design Lead', detail: 'Used primary research, learning literature, rapid prototypes, playtesting, and stakeholder feedback to explore and revise learning-experience concepts.' },
  { dates: '2022–2026 · Volunteer', company: 'Tech Fleet Community DAO', role: 'UX Researcher', detail: 'Designed and conducted interviews, surveys, and A/B tests, and co-designed app engagement features on a cross-functional client team.' },
  { dates: '2018', company: 'SIG SAUER', role: 'Design Engineer', detail: 'Automated the migration of inventory and ticket data from large spreadsheets into Oracle.' },
  { dates: 'May 2015–May 2017', company: 'IDL Worldwide', role: 'Design Engineer', detail: 'Produced store drawings for a nationwide Apple fixture rollout and digitized 500+ AT&T locations in SolidWorks. The workflow improvement is the case study above.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Work — Jacob Meyerkopf, Interactive Researcher & Product Designer"
      description="UX research, independent interface prototypes, and professional design-engineering work by Jacob Meyerkopf."
    />
  </head>
  <body class="pv2-body">
    <PortfolioPolish />
    <PortfolioBackdrop />
    <div class="pv2-site">
      <SiteNav />

      <main class="uxw">
        <section class="uxw-hero" aria-labelledby="uxw-title">
          <div class="uxw-hero__main">
            <p class="pv2-overline">Interactive Researcher &amp; Product Designer</p>
            <h1 id="uxw-title">Making complex systems make sense from the inside.</h1>
            <p class="uxw-lead">I'm Jacob Meyerkopf. I bring UX research, prototyping, and a design-engineering background to problems where people need a clearer next step.</p>
            <div class="uxw-actions">
              <a class="uxw-button" href="#selected-work">Explore selected work</a>
              <a class="uxw-link" href={RESUME} download>Download resume (PDF)</a>
            </div>
          </div>
          <aside class="uxw-panel uxw-hero__aside" aria-labelledby="uxw-proof">
            <p class="pv2-overline" id="uxw-proof">The short version</p>
            <ul class="uxw-proof">
              {proof.map((item) => (
                <li>
                  <span class="uxw-proof__value">{item.value}</span>
                  <span class="uxw-proof__label">{item.label}</span>
                </li>
              ))}
            </ul>
            <p class="uxw-muted uxw-proof__foot">Tel Aviv-Yafo, Israel · Native English · Authorized to work in Israel</p>
          </aside>
        </section>

        <section class="uxw-section" id="selected-work" aria-labelledby="uxw-selected">
          <div class="uxw-heading">
            <p class="pv2-overline">Case studies</p>
            <h2 id="uxw-selected">Selected work</h2>
            <p>A client research and product-design engagement, an independent learning prototype, and a professional CAD workflow. Each card states what I did, what came of it, and what it does not prove.</p>
          </div>

          <div class="uxw-cases">
            {selected.map((data) => {
              const visual = visuals[data.slug];
              const caseLink = data.links?.find((link) => !link.external);
              const otherLinks = data.links?.filter((link) => link !== caseLink) ?? [];
              const bars = visual?.bars;
              const max = bars ? Math.max(...bars.values) : 1;
              const steps = visual?.steps;

              const Media = (
                <figure class="uxw-shot">
                  <img src={visual?.src} alt={visual?.alt} loading="lazy" decoding="async" />
                </figure>
              );

              const Bars = bars && (
                <figure class="uxw-bars">
                  <figcaption class="uxw-label">{bars.label}</figcaption>
                  {bars.labels.map((label, i) => (
                    <div class={`uxw-bar${i === bars.values.length - 1 ? ' is-mine' : ''}`}>
                      <span class="uxw-bar__label">{label}</span>
                      <span class="uxw-bar__track"><span class="uxw-bar__fill" style={`width: ${(bars.values[i] / max) * 100}%`}></span></span>
                      <span class="uxw-bar__value">{bars.values[i]} {bars.suffix}</span>
                    </div>
                  ))}
                </figure>
              );

              const Steps = steps && (
                <figure class="uxw-steps">
                  <figcaption>
                    <span class="uxw-label">{steps.eyebrow}</span>
                    <strong>{steps.title}</strong>
                  </figcaption>
                  <ol>{steps.steps.map((step) => <li>{step.title}</li>)}</ol>
                </figure>
              );

              const outcome = outcomes[data.slug];
              const fact = facts[data.slug];

              // One anatomy for all three: who and where, the title, the claim,
              // the result, the scope. The old card said everything twice —
              // a sharp framing sentence followed by the CV restatement of the
              // same point — which halved the force of the good line. The
              // summary still lives in the project data and still runs on the
              // index below; it just no longer echoes the claim here.
              const Text = (
                <div class="uxw-case__text">
                  <p class="uxw-label">{labels[data.slug]}</p>
                  <h3>{data.title}</h3>
                  <p class="uxw-case__claim">{claims[data.slug]}</p>
                  {outcome && (
                    <div class="uxw-outcome">
                      <p class="uxw-outcome__value">{outcome.value}</p>
                      <p class="uxw-outcome__note">{outcome.note}</p>
                    </div>
                  )}
                  {fact && <ul class="uxw-facts">{fact.map((item) => <li>{item}</li>)}</ul>}
                </div>
              );

              // Pulled out of the text block. On the split layout the button
              // used to land between the writing and the two artefacts, so the
              // call to action sat in the middle of the card. Every card now
              // ends on it.
              const Actions = (
                <div class="uxw-actions uxw-case__actions">
                  {caseLink && <a class="uxw-button" href={caseLink.href}>{caseLink.label}<span class="sr-only">: {data.title}</span></a>}
                  {otherLinks.map((link) => (
                    <a class="uxw-link" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                      {link.label} {link.external && <span aria-hidden="true">↗</span>}<span class="sr-only">: {data.title}{link.external ? ' (opens in a new tab)' : ''}</span>
                    </a>
                  ))}
                </div>
              );

              // A layout that names content the piece does not have used to
              // render an empty card in silence: IDL sat on 'diagram', which
              // draws `steps`, while IDL has `bars` — so it lost both its
              // photograph and its chart and nothing failed. Fall back to
              // whatever the piece actually carries.
              const has = { media: !!visual?.src, bars: !!bars, steps: !!steps };
              const layout = visual?.layout === 'media' && has.media ? 'media'
                : visual?.layout === 'split' && (has.media || has.bars) ? 'split'
                : visual?.layout === 'diagram' && has.steps ? 'diagram'
                : has.steps ? 'diagram'
                : has.media && has.bars ? 'split'
                : has.media ? 'media'
                : 'diagram';

              return (
                <article class={`uxw-case uxw-case--${layout}`}>
                  {Text}
                  {layout === 'media' && Media}
                  {layout === 'split' && <div class="uxw-case__pair">{has.media && Media}{Bars}</div>}
                  {layout === 'diagram' && Steps}
                  {Actions}
                </article>
              );
            })}
          </div>
        </section>

        <section class="uxw-section" id="experience" aria-labelledby="uxw-experience">
          <div class="uxw-heading">
            <p class="pv2-overline">Experience</p>
            <h2 id="uxw-experience">Professional experience</h2>
          </div>
          <ol class="uxw-timeline">
            {experience.map((item) => (
              <li>
                <span class="uxw-timeline__dates">{item.dates}</span>
                <div>
                  <h3>{item.company}</h3>
                  <p class="uxw-timeline__role">{item.role}</p>
                  <p class="uxw-muted">{item.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="uxw-section" aria-labelledby="uxw-further">
          <div class="uxw-heading">
            <p class="pv2-overline">More</p>
            <h2 id="uxw-further">Further explorations</h2>
          </div>
          <!-- Three of these four have no image of the work, and three empty
               typed panels in a row read as an unfinished site rather than as a
               deliberate choice. This is an index, so it is set as one. -->
          <ul class="uxw-index">
            {supporting.map((data) => {
              const link = data.links?.[0];
              return (
                <li class="uxw-index__row">
                  <div class="uxw-index__head">
                    <h3>{data.title}</h3>
                    <p class="uxw-label">{data.tagline}</p>
                  </div>
                  <p class="uxw-index__note">{data.summary}</p>
                  {link && (
                    <a class="uxw-link uxw-index__link" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                      {link.label} <span aria-hidden="true">{link.external ? '\u2197' : '\u2192'}</span><span class="sr-only">: {data.title}{link.external ? ' (opens in a new tab)' : ''}</span>
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </section>

        <section class="uxw-section uxw-contact" id="contact" aria-labelledby="uxw-contact">
          <h2 id="uxw-contact">Let's talk about the work.</h2>
          <p>I'm exploring product-design and UX-research opportunities. Contact me to discuss a role or ask about a project.</p>
          <div class="uxw-contact__links">
            <a href="mailto:jmeyerkopf@gmail.com">jmeyerkopf@gmail.com</a>
            <a href="https://www.linkedin.com/in/jacobmeyerkopf/" target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
            <a href={RESUME} download>Resume (PDF)</a>
            <a href={HOME}>Creative playground</a>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

<style is:global>
  .uxw {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(32px, 7vh, 82px) clamp(16px, 4vw, 48px) clamp(64px, 10vh, 120px);
  }

  .uxw p { line-height: 1.55; }
  .uxw-muted { color: #5f5b55; }

  .uxw-label {
    margin: 0;
    color: var(--pv2-accent);
    font-size: .7rem;
    font-weight: 650;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  /* --- Hero ---------------------------------------------------------------- */
  .uxw-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .65fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: end;
  }

  .uxw-hero h1 {
    margin: 0 0 clamp(16px, 2.6vh, 26px);
    font-size: clamp(2.6rem, 5.4vw, 4.9rem);
    line-height: .98;
    letter-spacing: -.055em;
    font-weight: 510;
    text-wrap: balance;
  }

  .uxw-lead {
    max-width: 58ch;
    margin: 0;
    color: #3d3a36;
    font-size: clamp(1.02rem, 1.35vw, 1.18rem);
  }

  .uxw-panel {
    padding: clamp(20px, 2.6vw, 28px);
    border: 1px solid var(--pv2-line);
    border-radius: var(--pv2-r-lg);
    background: rgba(255, 255, 255, .66);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .uxw-panel p { margin: 0; }
  .uxw-panel p + p { margin-top: 12px; }
  .uxw-panel .uxw-muted { font-size: .9rem; }

  /* Three checkable facts in place of the paragraph that used to restate the
     experience timeline further down the page. */
  .uxw-proof {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .uxw-proof li {
    display: grid;
    gap: 2px;
    padding: 12px 0;
    border-top: 1px solid var(--pv2-line);
  }

  .uxw-proof li:first-child { border-top: 0; padding-top: 0; }

  .uxw-proof__value {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -.035em;
    font-variant-numeric: tabular-nums;
  }

  .uxw-proof__label {
    color: var(--pv2-muted);
    font-size: .85rem;
    line-height: 1.4;
  }

  .uxw-proof__foot {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--pv2-line);
  }

  .uxw-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 26px;
  }

  .uxw-button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--pv2-accent);
    color: #faf8f4;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--pv2-fast) ease;
  }

  .uxw-button:hover { background: var(--pv2-accent-deep); }

  .uxw-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--pv2-text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(36, 36, 36, .3);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--pv2-fast) ease;
  }

  .uxw-link:hover { text-decoration-color: currentColor; }

  .uxw-button:focus-visible,
  .uxw-link:focus-visible,
  .uxw-contact a:focus-visible {
    outline: 2px solid var(--pv2-text);
    outline-offset: 3px;
  }

  /* --- Sections ------------------------------------------------------------ */
  .uxw-section {
    margin-top: clamp(72px, 11vh, 128px);
  }

  .uxw-heading {
    max-width: 760px;
    margin-bottom: 28px;
  }

  .uxw-heading h2 {
    margin: 0 0 12px;
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    line-height: 1;
    letter-spacing: -.045em;
    font-weight: 520;
  }

  .uxw-heading > p:last-child:not(.pv2-overline) {
    max-width: 64ch;
    margin: 0;
    color: #4f4c47;
    font-size: clamp(1rem, 1.3vw, 1.12rem);
  }

  /* --- Case studies -------------------------------------------------------- */
  .uxw-cases {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vh, 56px);
  }

  /* Three layouts, not three copies of one. Each is driven by what the piece
     actually has to show; the shared rules are only the shell. */
  .uxw-case {
    display: grid;
    gap: clamp(22px, 3vw, 40px);
    padding: clamp(22px, 3.4vw, 40px);
    border: 1px solid var(--pv2-line);
    border-radius: var(--pv2-r-lg);
    background: rgba(255, 255, 255, .7);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  /* Image-led: the screen runs the full width of the card. The work is the
     argument, so it gets the room — but the label and title still come first,
     because that is what a reviewer scans. */
  .uxw-case--media { grid-template-columns: minmax(0, 1fr); }
  .uxw-case--media .uxw-case__text { max-width: var(--pv2-measure); }

  /* Two real artefacts side by side: the photograph of the drawings and the
     numbers they produced. */
  .uxw-case--split { grid-template-columns: minmax(0, 1fr); }
  .uxw-case__pair {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    gap: clamp(18px, 2.4vw, 32px);
    align-items: stretch;
  }

  /* Nothing is built, so the documented flow is the visual and it runs wide
     rather than being squeezed into a half-column. */
  .uxw-case--diagram { grid-template-columns: minmax(0, 1fr); }
  .uxw-case--diagram .uxw-case__text { max-width: var(--pv2-measure); }

  .uxw-case h3 {
    margin: 12px 0 14px;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    line-height: 1.08;
    letter-spacing: -.035em;
    font-weight: 560;
    text-wrap: balance;
  }

  /* The claim. One sentence that says something, where three bullets used to
     sit saying nothing. */
  .uxw-case__claim {
    margin: 0;
    max-width: var(--pv2-measure);
    color: var(--pv2-text);
    font-size: var(--pv2-step-lead);
    line-height: 1.45;
  }

  /* The result. Set at heading weight and marked with the accent rule, because
     on a work page this is the sentence the reader came for — it should not
     have to be found inside a paragraph. */
  .uxw-outcome {
    max-width: var(--pv2-measure);
    margin-top: clamp(18px, 2.2vh, 24px);
    padding-left: clamp(14px, 1.4vw, 18px);
    border-left: 3px solid var(--pv2-accent);
  }

  .uxw-outcome__value {
    margin: 0 0 6px;
    font-size: clamp(1.3rem, 2.1vw, 1.8rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -.035em;
    font-variant-numeric: tabular-nums;
    text-wrap: balance;
  }

  .uxw-outcome__note {
    margin: 0;
    color: var(--pv2-muted);
    font-size: .92rem;
  }

  /* Role, scope, dates. Small, but first in the order a reviewer actually asks
     questions in, and the only place a volunteer engagement is distinguished
     from a staff job. */
  .uxw-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    margin: clamp(16px, 2vh, 22px) 0 0;
    padding: 0;
    list-style: none;
    color: #4f4c47;
    font-size: .86rem;
    line-height: 1.5;
  }

  .uxw-facts li + li::before {
    content: '·';
    padding: 0 10px;
    color: rgba(36, 36, 36, .32);
  }

  /* The article is a grid, so the actions row inherits the card gap; its own
     margin would double it. */
  .uxw-case__actions { margin-top: 0; }

  @media (max-width: 760px) {
