---
// The Work screen, inside the portfolio's own system: the same painting
// backdrop, type and nav as the homepage and the playground, so the UX door
// leads into the same house. Project copy comes from src/content/projects.
import { getCollection } from 'astro:content';
import PortfolioBackdrop from '../components/PortfolioBackdrop.astro';
import PortfolioPolish from '../components/PortfolioPolish.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteHead from '../components/SiteHead.astro';
import '../styles/portfolio-v2.css';
import '../styles/portfolio-chrome.css';
import '../styles/portfolio-case.css';

// Shared with the homepage, playground and case studies.
import { HOME, RESUME } from '../data/siteNav';

const projects = await getCollection('projects');
const bySlug = (slug) => projects.find((project) => project.data.slug === slug)?.data;

const selectedSlugs = ['earth-hero', 'letter-river', 'idl'];
const selected = selectedSlugs.map(bySlug).filter(Boolean);
const labels = {
  'earth-hero': 'Client work · Tech Fleet',
  'letter-river': 'Independent prototype',
  idl: 'Professional design engineering',
};

// Each piece takes the shape its own evidence wants, rather than all three
// repeating one card. Three identical modules in a row is the thing that reads
// as a template no matter how good the type is.
//
//   letter-river  a real screenshot of the running app, so the screen leads
//                 and the writing sits underneath it
//   idl           a photograph of the actual store drawings beside the real
//                 before/after numbers: two artefacts, no mockup
//   ai-archiving  a concept with nothing built, so its own documented flow is
//                 the visual and it runs the full width
//
// Everything here is real material. public/images/ai-archiver.png is an
// AI-generated picture of an interface — its labels read "ALASSISTANT",
// "Confience level", "game wirning point" — so it is deliberately not used:
// a generated screenshot presented as prototype work is the fastest way to
// lose a reviewer's trust.
const visuals = {
  'earth-hero': {
    layout: 'diagram',
    steps: {
      eyebrow: 'The loop',
      title: 'Quest, action, points, team',
      steps: [
        { title: 'Choose a quest' },
        { title: 'Log a daily action' },
        { title: 'Earn Earth Points' },
        { title: 'Join a team' },
        { title: 'See where you stand' },
      ],
    },
  },
  'letter-river': {
    layout: 'split',
    src: '/images/derived/Desktop_Hero_Screen-1400.webp',
    alt: 'Letter River home screen: language pickers, a greeting, and the Bridge Builder lesson in progress',
  },
  idl: {
    layout: 'diagram',
    src: '/images/derived/idl-case-study-1100.webp',
    alt: 'Store drawings and fixture elevations spread across a desk',
    bars: bySlug('idl')?.caseStudy?.solution?.bars,
  },
};

// One sentence that makes a claim, in place of three bullets that were labels.
// Each is drawn from the case study's own copy, not invented here.
const claims = {
  'earth-hero': 'People who already care about their footprint still stop logging actions after a week, so the work was motivation design \u2014 and then a study written to check whether players read the mechanics the way we intended.',
  'letter-river': 'A learner who can name a letter still cannot hear it inside a word, so recognition, vocabulary and reading are one connected path rather than three separate drills.',
  idl: 'Two stages, kept apart on purpose: the team took drawing turnaround from eight hours to two, and I then refined my own workflow to 37 minutes across 500+ AT&T locations.',
};

const supporting = projects
  .filter((project) => !selectedSlugs.includes(project.data.slug))
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => project.data);

// Exploration thumbnails, where a real one exists. A card with no entry here
// is typed instead of filled, and says what state the work is in:
//   agora-21      the only image is a photograph of a text slide, not the work
//   ai-archiving  public/images/ai-archiver.png is an AI-generated picture of
//                 an interface, so it is deliberately not shown
//   bball         no interface capture in the repository
const thumbs = {
  rotogo: { src: '/images/derived/rotogoscreen-768.webp', fit: 'cover' },
};

const typeCardNote = {
  'agora-21': 'Concept \u00b7 not built',
  'ai-archiving': 'Concept \u00b7 prototype',
  bball: 'Personal project',
};

// Most recent first.
const experience = [
  { dates: '2023–2026', company: 'Active Learning Adventures', role: 'Design Lead', detail: 'Used primary research, learning literature, rapid prototypes, playtesting, and stakeholder feedback to explore and revise learning-experience concepts.' },
  { dates: '2022–2026 · Volunteer', company: 'Tech Fleet Community DAO', role: 'UX Researcher', detail: 'Designed and conducted interviews, surveys, and A/B tests. Co-designed app engagement features and presented recommendations to the client, who incorporated elements into its live product.' },
  { dates: '2018', company: 'SIG SAUER', role: 'Design Engineer', detail: 'Automated the migration of inventory and ticket data from large spreadsheets into Oracle.' },
  { dates: 'May 2015–May 2017', company: 'IDL Worldwide', role: 'Design Engineer', detail: 'Worked with the team to reduce store-drawing turnaround from eight hours to two hours, then personally reduced it to 37 minutes. Digitized 500+ AT&T locations in SolidWorks for Apple fixture installations.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Work — Jacob Meyerkopf, Interactive Researcher & Product Designer"
      description="UX research, independent interface prototypes, and professional design-engineering work by Jacob Meyerkopf."
    />
  </head>
  <body class="pv2-body">
    <PortfolioPolish />
    <PortfolioBackdrop />
    <div class="pv2-site">
      <SiteNav />

      <main class="uxw">
        <section class="uxw-hero" aria-labelledby="uxw-title">
          <div class="uxw-hero__main">
            <p class="pv2-overline">Interactive Researcher &amp; Product Designer</p>
            <h1 id="uxw-title">Making complex systems make sense from the inside.</h1>
            <p class="uxw-lead">I'm Jacob Meyerkopf. I bring UX research, prototyping, and a design-engineering background to problems where people need a clearer next step.</p>
            <div class="uxw-actions">
              <a class="uxw-button" href="#selected-work">Explore selected work</a>
              <a class="uxw-link" href={RESUME} download>Download resume (PDF)</a>
            </div>
          </div>
          <aside class="uxw-panel uxw-hero__aside" aria-labelledby="uxw-background">
            <p class="pv2-overline" id="uxw-background">Background</p>
            <p>Client application research at Tech Fleet, learning-experience prototyping at Active Learning Adventures, and workflow improvement at IDL Worldwide.</p>
            <p class="uxw-muted">Tel Aviv-Yafo, Israel · Native English · Authorized to work in Israel</p>
          </aside>
        </section>

        <section class="uxw-section" id="selected-work" aria-labelledby="uxw-selected">
          <div class="uxw-heading">
            <p class="pv2-overline">Case studies</p>
            <h2 id="uxw-selected">Selected work</h2>
            <p>A learning interface, a professional CAD workflow, and an AI review concept. Each case study identifies the work's scope and status.</p>
          </div>

          <div class="uxw-cases">
            {selected.map((data) => {
              const visual = visuals[data.slug];
              const caseLink = data.links?.find((link) => !link.external);
              const otherLinks = data.links?.filter((link) => link !== caseLink) ?? [];
              const bars = visual?.bars;
              const max = bars ? Math.max(...bars.values) : 1;
              const steps = visual?.steps;

              const Media = (
                <figure class="uxw-shot">
                  <img src={visual?.src} alt={visual?.alt} loading="lazy" decoding="async" />
                </figure>
              );

              const Bars = bars && (
                <figure class="uxw-bars">
                  <figcaption class="uxw-label">{bars.label}</figcaption>
                  {bars.labels.map((label, i) => (
                    <div class={`uxw-bar${i === bars.values.length - 1 ? ' is-mine' : ''}`}>
                      <span class="uxw-bar__label">{label}</span>
                      <span class="uxw-bar__track"><span class="uxw-bar__fill" style={`width: ${(bars.values[i] / max) * 100}%`}></span></span>
                      <span class="uxw-bar__value">{bars.values[i]} {bars.suffix}</span>
                    </div>
                  ))}
                </figure>
              );

              const Steps = steps && (
                <figure class="uxw-steps">
                  <figcaption>
                    <span class="uxw-label">{steps.eyebrow}</span>
                    <strong>{steps.title}</strong>
                  </figcaption>
                  <ol>{steps.steps.map((step) => <li>{step.title}</li>)}</ol>
                </figure>
              );

              const Text = (
                <div class="uxw-case__text">
                  <p class="uxw-label">{labels[data.slug]}</p>
                  <h3>{data.title}</h3>
                  <p class="uxw-case__claim">{claims[data.slug]}</p>
                  <p class="uxw-case__summary">{data.summary}</p>
                  <div class="uxw-actions">
                    {caseLink && <a class="uxw-button" href={caseLink.href}>{caseLink.label}<span class="sr-only">: {data.title}</span></a>}
                    {otherLinks.map((link) => (
                      <a class="uxw-link" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                        {link.label} {link.external && <span aria-hidden="true">↗</span>}<span class="sr-only">: {data.title}{link.external ? ' (opens in a new tab)' : ''}</span>
                      </a>
                    ))}
                  </div>
                </div>
              );

              return (
                <article class={`uxw-case uxw-case--${visual?.layout ?? 'media'}`}>
                  {visual?.layout === 'media' && <>{Media}{Text}</>}
                  {visual?.layout === 'split' && <>{Text}<div class="uxw-case__pair">{Media}{Bars}</div></>}
                  {visual?.layout === 'diagram' && <>{Text}{Steps}</>}
                </article>
              );
            })}
          </div>
        </section>

        <section class="uxw-section" id="experience" aria-labelledby="uxw-experience">
          <div class="uxw-heading">
            <p class="pv2-overline">Experience</p>
            <h2 id="uxw-experience">Professional experience</h2>
          </div>
          <ol class="uxw-timeline">
            {experience.map((item) => (
              <li>
                <span class="uxw-timeline__dates">{item.dates}</span>
                <div>
                  <h3>{item.company}</h3>
                  <p class="uxw-timeline__role">{item.role}</p>
                  <p class="uxw-muted">{item.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="uxw-section" aria-labelledby="uxw-further">
          <div class="uxw-heading">
            <p class="pv2-overline">More</p>
            <h2 id="uxw-further">Further explorations</h2>
          </div>
          <div class="uxw-explore">
            {supporting.map((data) => {
              const thumb = thumbs[data.slug];
              const link = data.links?.[0];
              return (
                <article class="uxw-explore__card">
                  <div class={`uxw-explore__thumb${thumb ? '' : ' is-type'}`}>
                    {thumb
                      ? <img src={thumb.src} alt="" loading="lazy" decoding="async" style={`object-fit: ${thumb.fit}`} />
                      : <span aria-hidden="true">{typeCardNote[data.slug] ?? 'Case study'}</span>}
                  </div>
                  <p class="uxw-label">{data.tagline}</p>
                  <h3>{data.title}</h3>
                  <p class="uxw-muted">{data.summary}</p>
                  {link && (
                    <a class="uxw-link" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                      {link.label} {link.external ? <span aria-hidden="true">↗</span> : <span aria-hidden="true">→</span>}<span class="sr-only">: {data.title}{link.external ? ' (opens in a new tab)' : ''}</span>
                    </a>
                  )}
                </article>
              );
            })}
          </div>
        </section>

        <section class="uxw-section uxw-contact" id="contact" aria-labelledby="uxw-contact">
          <h2 id="uxw-contact">Let's talk about the work.</h2>
          <p>I'm exploring product-design and UX-research opportunities. Contact me to discuss a role or ask about a project.</p>
          <div class="uxw-contact__links">
            <a href="mailto:jmeyerkopf@gmail.com">jmeyerkopf@gmail.com</a>
            <a href="https://www.linkedin.com/in/jacobmeyerkopf/" target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
            <a href={RESUME} download>Resume (PDF)</a>
            <a href={HOME}>Creative playground</a>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

<style is:global>
  .uxw {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(32px, 7vh, 82px) clamp(16px, 4vw, 48px) clamp(64px, 10vh, 120px);
  }

  .uxw p { line-height: 1.55; }
  .uxw-muted { color: #5f5b55; }

  .uxw-label {
    margin: 0;
    color: var(--pv2-accent);
    font-size: .7rem;
    font-weight: 650;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  /* --- Hero ---------------------------------------------------------------- */
  .uxw-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .65fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: end;
  }

  .uxw-hero h1 {
    margin: 0 0 clamp(16px, 2.6vh, 26px);
    font-size: clamp(2.6rem, 5.4vw, 4.9rem);
    line-height: .98;
    letter-spacing: -.055em;
    font-weight: 510;
    text-wrap: balance;
  }

  .uxw-lead {
    max-width: 58ch;
    margin: 0;
    color: #3d3a36;
    font-size: clamp(1.02rem, 1.35vw, 1.18rem);
  }

  .uxw-panel {
    padding: clamp(20px, 2.6vw, 28px);
    border: 1px solid var(--pv2-line);
    border-radius: var(--pv2-r-lg);
    background: rgba(255, 255, 255, .66);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .uxw-panel p { margin: 0; }
  .uxw-panel p + p { margin-top: 12px; }
  .uxw-panel .uxw-muted { font-size: .9rem; }

  .uxw-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 26px;
  }

  .uxw-button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--pv2-accent);
    color: #faf8f4;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--pv2-fast) ease;
  }

  .uxw-button:hover { background: var(--pv2-accent-deep); }

  .uxw-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--pv2-text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(36, 36, 36, .3);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--pv2-fast) ease;
  }

  .uxw-link:hover { text-decoration-color: currentColor; }

  .uxw-button:focus-visible,
  .uxw-link:focus-visible,
  .uxw-contact a:focus-visible {
    outline: 2px solid var(--pv2-text);
    outline-offset: 3px;
  }

  /* --- Sections ------------------------------------------------------------ */
  .uxw-section {
    margin-top: clamp(72px, 11vh, 128px);
  }

  .uxw-heading {
    max-width: 760px;
    margin-bottom: 28px;
  }

  .uxw-heading h2 {
    margin: 0 0 12px;
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    line-height: 1;
    letter-spacing: -.045em;
    font-weight: 520;
  }

  .uxw-heading > p:last-child:not(.pv2-overline) {
    max-width: 64ch;
    margin: 0;
    color: #4f4c47;
    font-size: clamp(1rem, 1.3vw, 1.12rem);
  }

  /* --- Case studies -------------------------------------------------------- */
  .uxw-cases {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vh, 56px);
  }

  /* Three layouts, not three copies of one. Each is driven by what the piece
     actually has to show; the shared rules are only the shell. */
  .uxw-case {
    display: grid;
    gap: clamp(22px, 3vw, 40px);
    padding: clamp(22px, 3.4vw, 40px);
    border: 1px solid var(--pv2-line);
    border-radius: var(--pv2-r-lg);
    background: rgba(255, 255, 255, .7);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  /* Image-led: the screen runs the full width of the card and the writing
     sits under it. The work is the argument, so it gets the room. */
  .uxw-case--media { grid-template-columns: minmax(0, 1fr); }
  .uxw-case--media .uxw-case__text { max-width: var(--pv2-measure); }

  /* Two real artefacts side by side: the photograph of the drawings and the
     numbers they produced. */
  .uxw-case--split { grid-template-columns: minmax(0, 1fr); }
  .uxw-case__pair {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    gap: clamp(18px, 2.4vw, 32px);
    align-items: center;
  }

  /* Nothing is built, so the documented flow is the visual and it runs wide
     rather than being squeezed into a half-column. */
  .uxw-case--diagram { grid-template-columns: minmax(0, 1fr); }
  .uxw-case--diagram .uxw-case__text { max-width: var(--pv2-measure); }

  .uxw-case h3 {
    margin: 12px 0 14px;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    line-height: 1.08;
    letter-spacing: -.035em;
    font-weight: 560;
    text-wrap: balance;
  }

  /* The claim. One sentence that says something, where three bullets used to
     sit saying nothing. */
  .uxw-case__claim {
    margin: 0 0 14px;
    max-width: var(--pv2-measure);
    color: var(--pv2-text);
    font-size: var(--pv2-step-lead);
    line-height: 1.45;
  }

  .uxw-case__summary {
    margin: 0;
    max-width: var(--pv2-measure);
    color: var(--pv2-muted);
    font-size: .94rem;
  }

  @media (max-width: 760px) {
    .uxw-case__pair { grid-template-columns: minmax(0, 1fr); }
  }

  .uxw-shot {
    margin: 0;
    overflow: hidden;
    border-radius: var(--pv2-r-md);
    border: 1px solid rgba(36, 36, 36, .12);
    background: var(--pv2-soft);
    box-shadow: 0 18px 40px -24px rgba(36, 30, 20, .55);
  }

  .uxw-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The 1400px screenshot is wider than it is tall and leads the card, so it
     is shown whole rather than cropped into a tile. */
  .uxw-case--media .uxw-shot img { aspect-ratio: auto; }

  /* The drawings photograph is portrait; capping it keeps it from towering
     over the numbers beside it. */
  .uxw-case--split .uxw-shot img {
    max-height: 420px;
    object-fit: cover;
    object-position: center;
  }

  /* IDL: the work's own numbers, drawn. */
  .uxw-bars {
    margin: 0;
    padding: clamp(18px, 2.4vw, 26px);
    border-radius: var(--pv2-r-md);
    background: rgba(247, 246, 242, .9);
    border: 1px solid rgba(36, 36, 36, .1);
  }

  .uxw-bars figcaption { margin-bottom: 18px; }

  .uxw-bar {
    display: grid;
    grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr) 4.2rem;
    align-items: center;
    gap: 12px;
    font-size: .88rem;
  }

  .uxw-bar + .uxw-bar { margin-top: 12px; }

  .uxw-bar__label { color: #4f4c47; }

  .uxw-bar__track {
    height: 14px;
    border-radius: 999px;
    background: rgba(36, 36, 36, .07);
    overflow: hidden;
  }

  .uxw-bar__fill {
    display: block;
    height: 100%;
    min-width: 4px;
    border-radius: inherit;
    background: #b9b4ab;
  }

  .uxw-bar.is-mine .uxw-bar__fill { background: var(--pv2-text); }
  .uxw-bar.is-mine .uxw-bar__label,
  .uxw-bar.is-mine .uxw-bar__value { color: var(--pv2-text); font-weight: 650; }

  .uxw-bar__value {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: #4f4c47;
  }

  /* AI Archiving: its documented workflow, drawn. */
  .uxw-steps {
    margin: 0;
    padding: clamp(18px, 2.4vw, 26px);
    border-radius: var(--pv2-r-md);
    background: rgba(247, 246, 242, .9);
    border: 1px solid rgba(36, 36, 36, .1);
  }

  .uxw-steps figcaption {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 18px;
  }

  .uxw-steps figcaption strong {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -.02em;
  }

  .uxw-steps ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
  }

  .uxw-steps li {
    counter-increment: step;
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    font-size: .95rem;
  }

  .uxw-steps li::before {
    content: counter(step);
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid rgba(36, 36, 36, .25);
    background: #fff;
    font-size: .8rem;
    font-weight: 650;
    position: relative;
    z-index: 1;
  }

  /* The line that joins the steps. */
  .uxw-steps li + li::after {
    content: '';
    position: absolute;
    left: 15px;
    top: -10px;
    height: 20px;
    width: 1px;
    background: rgba(36, 36, 36, .22);
  }

  .uxw-steps li:last-child::before {
    background: var(--pv2-text);
    border-color: var(--pv2-text);
    color: #f7f6f2;
  }

  /* --- Experience ---------------------------------------------------------- */
  .uxw-timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(36, 36, 36, .14);
  }

  .uxw-timeline li {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    gap: 12px 32px;
    padding: 22px 0;
    border-bottom: 1px solid rgba(36, 36, 36, .14);
  }

  .uxw-timeline__dates {
    color: #4f4c47;
    font-size: .88rem;
    font-variant-numeric: tabular-nums;
    padding-top: 4px;
  }

  .uxw-timeline h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -.02em;
  }

  .uxw-timeline__role {
    margin: 2px 0 8px;
    font-weight: 500;
  }

  .uxw-timeline .uxw-muted {
    margin: 0;
    max-width: 70ch;
  }

  /* The timeline sits on the painting; give it the same panel as the cards. */
  .uxw-section#experience .uxw-timeline {
    padding: 0 clamp(18px, 2.6vw, 28px);
    border: 1px solid var(--pv2-line);
    border-radius: var(--pv2-r-lg);
    background: rgba(255, 255, 255, .66);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .uxw-section#experience .uxw-timeline li:last-child { border-bottom: 0; }

  /* --- Further explorations ------------------------------------------------ */
  .uxw-explore {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

