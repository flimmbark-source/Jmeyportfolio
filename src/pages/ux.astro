---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
const selectedSlugs = ['letter-river', 'idl', 'ai-archiving'];
const selected = selectedSlugs.map((slug) => projects.find((project) => project.data.slug === slug));
const supporting = projects.filter((project) => project.data.image && !selectedSlugs.includes(project.data.slug)).sort((a, b) => a.data.order - b.data.order);
const labels = { 'letter-river': 'Independent prototype', idl: 'Professional design engineering', 'ai-archiving': 'Independent concept / prototype' };
const experience = [
  { dates: '2022–2026 · Volunteer', company: 'Tech Fleet Community DAO', role: 'UX Researcher', detail: 'Designed and conducted interviews, surveys, and A/B tests. Co-designed app engagement features and presented recommendations to the client, who incorporated elements into its live product.' },
  { dates: '2023–2026', company: 'Active Learning Adventures', role: 'Design Lead', detail: 'Used primary research, learning literature, rapid prototypes, playtesting, and stakeholder feedback to explore and revise learning-experience concepts.' },
  { dates: 'May 2015–May 2017', company: 'IDL Worldwide', role: 'Design Engineer', detail: 'Worked with the team to reduce store-drawing turnaround from eight hours to two hours, then personally reduced it to 37 minutes. Digitized 500+ AT&T locations in SolidWorks for Apple fixture installations.' },
  { dates: '2018', company: 'SIG SAUER', role: 'Design Engineer', detail: 'Automated the migration of inventory and ticket data from large spreadsheets into Oracle.' }
];
const navLinks = [{ href: '#projects', label: 'Selected work' }, { href: '#experience', label: 'Experience' }, { href: '#contact', label: 'Contact' }];
---
<BaseLayout title="Jacob Meyerkopf | Product Design & UX Research" description="UX research, independent interface prototypes, and professional design-engineering work by Jacob Meyerkopf." mainClass="mx-auto max-w-6xl px-5 pb-20 pt-12 sm:px-6 sm:pt-16" navLinks={navLinks}>
  <section id="about-me" class="grid gap-8 lg:grid-cols-[1.35fr_0.65fr] lg:items-end">
    <div>
      <p class="eyebrow">Product design &amp; UX research</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight tracking-tight text-slate-950 dark:text-white sm:text-5xl">Making complex work easier to navigate.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-700 dark:text-slate-200">I'm Jacob Meyerkopf. I bring UX research, prototyping, and a design-engineering background to problems where people need a clearer next step.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="ux-button ux-button-primary" href="#projects">Explore selected work</a>
        <a class="ux-button" href="/resume/Jacob_Meyerkopf_Product_UX_Resume.pdf" download>Download resume (PDF)</a>
      </div>
    </div>
    <aside class="ux-panel">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400">Background</h2>
      <p class="mt-3 leading-relaxed text-slate-700 dark:text-slate-200">Client application research at Tech Fleet, learning-experience prototyping at Active Learning Adventures, and workflow improvement at IDL Worldwide.</p>
      <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">Tel Aviv-Yafo, Israel · Native English · Authorized to work in Israel</p>
    </aside>
  </section>
  <section id="projects" class="mt-16 scroll-mt-24">
    <div class="mb-7 max-w-2xl">
      <h2 class="text-3xl font-bold text-slate-950 dark:text-white">Selected work</h2>
      <p class="mt-3 leading-relaxed text-slate-700 dark:text-slate-200">A learning interface, a professional CAD workflow, and an AI review concept. Each case study identifies the work's scope and status.</p>
    </div>
    <div class="grid gap-6">
      {selected.map(({ data }) => (
        <article data-polish="panel" class={`grid gap-6 overflow-hidden rounded-3xl border border-slate-200 bg-white/90 p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900/90 sm:p-8 ${data.image ? 'lg:grid-cols-[1.15fr_0.85fr] lg:items-center' : ''}`}>
          <div>
            <p class="eyebrow">{labels[data.slug]}</p>
            <h3 class="mt-3 text-2xl font-bold text-slate-950 dark:text-white">{data.title}</h3>
            <p class="mt-4 max-w-3xl leading-relaxed text-slate-700 dark:text-slate-200">{data.summary}</p>
            <ul class="mt-5 space-y-2 text-sm text-slate-600 dark:text-slate-300">{data.highlights.map((highlight) => <li class="flex gap-2"><span aria-hidden="true" class="text-brand-600 dark:text-brand-300">•</span><span>{highlight}</span></li>)}</ul>
            <div class="mt-6 flex flex-wrap gap-3">{data.links?.map((link) => <a class={`ux-button ${link.variant === 'primary' ? 'ux-button-primary' : ''}`} href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}<span class="sr-only">: {data.title}{link.external ? ' (opens in a new tab)' : ''}</span></a>)}</div>
          </div>
          {data.image && <figure class="rounded-2xl border border-slate-200 bg-slate-100 p-3 dark:border-slate-700 dark:bg-slate-950"><img src={data.image.src} alt={data.image.alt} class="max-h-96 w-full rounded-xl object-contain" loading="lazy" /></figure>}
        </article>
      ))}
    </div>
  </section>
  <section id="experience" class="mt-16 scroll-mt-24">
    <h2 class="text-3xl font-bold text-slate-950 dark:text-white">Professional experience</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">{experience.map((item) => <article class="ux-panel"><p class="text-sm text-brand-700 dark:text-brand-300">{item.dates}</p><h3 class="mt-2 text-xl font-bold">{item.company}</h3><p class="mt-1 font-semibold">{item.role}</p><p class="mt-3 leading-relaxed text-slate-700 dark:text-slate-200">{item.detail}</p></article>)}</div>
  </section>
  <section class="mt-16">
    <h2 class="text-2xl font-bold text-slate-950 dark:text-white">Further explorations</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-3">{supporting.map(({ data }) => <article class="ux-panel"><h3 class="text-lg font-bold">{data.title}</h3><p class="mt-3 text-sm leading-relaxed text-slate-700 dark:text-slate-200">{data.summary}</p><div class="mt-4 flex flex-col items-start gap-3">{data.links?.map((link) => <a class="font-semibold text-brand-700 underline underline-offset-4 dark:text-brand-300" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}<span class="sr-only">: {data.title}{link.external ? ' (opens in a new tab)' : ''}</span></a>)}</div></article>)}</div>
  </section>
  <section id="contact" class="mt-16 scroll-mt-24 rounded-3xl bg-slate-900 p-7 text-white sm:p-10 dark:border dark:border-slate-700">
    <h2 class="text-3xl font-bold">Let's talk about the work.</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-slate-200">I'm exploring product-design and UX-research opportunities. Contact me to discuss a role or ask about a project.</p>
    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-4 font-semibold">
      <a class="underline underline-offset-4" href="mailto:jmeyerkopf@gmail.com">jmeyerkopf@gmail.com</a>
      <a class="underline underline-offset-4" href="https://www.linkedin.com/in/jacobmeyerkopf/" target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
      <a class="underline underline-offset-4" href="/resume/Jacob_Meyerkopf_Product_UX_Resume.pdf" download>Resume (PDF)</a>
      <a class="underline underline-offset-4" href="/">Creative playground</a>
    </div>
  </section>
</BaseLayout>
<style>
  .eyebrow { @apply text-xs font-semibold uppercase tracking-widest text-brand-700 dark:text-brand-300; }
  .ux-button { @apply inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-800 transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-600 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800; }
  .ux-button-primary { @apply border-brand-700 bg-brand-700 text-white hover:bg-brand-800 dark:border-brand-300 dark:bg-brand-300 dark:text-slate-950 dark:hover:bg-brand-200; }
  .ux-panel { @apply rounded-2xl border border-slate-200 bg-white/85 p-6 text-slate-950 dark:border-slate-700 dark:bg-slate-900/90 dark:text-white; }
</style>
