---
import RelationalPortfolio from '../components/RelationalPortfolio.jsx';
import PortfolioPolish from '../components/PortfolioPolish.astro';
import '../styles/portfolio-v2.css';
import '../styles/portfolio-chrome.css';
import '../styles/portfolio-v2-overrides.css';
import '../styles/portfolio-v2-adaptive.css';
import '../styles/portfolio-loading.css';
import '../styles/portfolio-incremental.css';
import '../styles/portfolio-battle.css';
import '../styles/portfolio-threshold.css';

// Preview of the threshold homepage: the playground, held at its statement
// until the visitor picks UX (left) or Play (right). The live homepage is
// src/pages/index.astro and is unchanged.

// Home, UX and the nav come from one place, shared with the playground,
// the UX screen and every case study.
import { HOME, UX, navLinks } from '../data/siteNav';

const statement = {
  headline: 'Interactive Researcher & Product Designer',
  subtext: 'My main drive is to create meaning from games and interactive art, through the use of thought experiments and UX Work.',
};

---
<!doctype html>
<html lang="en" data-ux-href={UX}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="Interactive work by Jacob Meyerkopf: games, disability experiences, learning systems, unfinished experiments, and UX work."
    />
    <link rel="preload" as="image" href="/images/levelup/chest-states.png" />
    <!-- The level-up cards and the upgrade tree both paint these 12 icons the
         instant they open. They are ~2KB each; fetching them with the document
         rather than when the first card is built is what keeps them from
         arriving a beat after the card they belong to. -->
    <link rel="preload" as="image" href="/icons/mechanics/speed.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/speed-floor.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/velocity-cap.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/launch.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/bounce.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/impact.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/stack.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/friction.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/zero-drag.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/collision.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/value.webp" type="image/webp" />
    <link rel="preload" as="image" href="/icons/mechanics/multiplier.webp" type="image/webp" />
    <title>Jacob Meyerkopf — Interactive Work</title>
  </head>
  <body class="pv2-body">
    <script is:inline>
      // The nav and the credit drawer are held back until the spheres have
      // landed, but RelationalPortfolio can only set that class once it has
      // mounted — by which time the bar has already painted and then
      // disappeared. Set it here, before the first paint, and let React take
      // it off at the end of the sequence.
      (() => {
        // The threshold always opens on the statement alone, so the chrome is
        // held on every visit. React releases it once the visitor picks Play.
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const root = document.documentElement;
        root.classList.add('pv2-intro-hold');
        // If the portfolio never mounts, the chrome must still come back. Once
        // it has mounted, the hold is the visitor's to end, however long they
        // take to choose.
        window.setTimeout(() => {
          if (!root.classList.contains('pv2-hydrated')) root.classList.remove('pv2-intro-hold');
        }, 18000);
      })();
    </script>
    <PortfolioPolish />
    <a class="pv2-skip" href="#portfolio-v2">Skip to work</a>
    <div class="pv2-boot-loader" aria-label="Loading portfolio" role="status">
      <div class="pv2-loader-dots" aria-hidden="true"><span></span><span></span><span></span></div>
    </div>
    <div id="portfolio-v2">
      <RelationalPortfolio
        client:load
        threshold
        homeHref={HOME}
        uxHref={UX}
        statement={statement}
        navLinks={navLinks}
      />
    </div>
    <script is:inline>
      (() => {
        const loader = document.querySelector('.pv2-boot-loader');
        if (!loader) return;

        const waitForPortfolio = new Promise((resolve) => {
          const check = () => {
            if (document.querySelector('#portfolio-v2 .pv2-site')) {
              requestAnimationFrame(resolve);
              return;
            }
            requestAnimationFrame(check);
          };
          check();
        });

        const finish = () => {
          if (!loader.isConnected) return;
          loader.classList.add('is-done');
          window.setTimeout(() => loader.remove(), 150);
        };

        // The shell is the critical content. Project media and the randomized
        // painting reveal progressively after it is interactive instead of
        // holding the visitor behind an artificial minimum loading screen.
        waitForPortfolio.then(finish);
        window.setTimeout(finish, 1500);
      })();
    </script>
    <script src="/scripts/portfolio-physics-v3.js?v=83" defer></script>
    <script src="/scripts/portfolio-battle.js?v=1" defer></script>
    <script src="/scripts/ux-direct-link.js?v=2" defer></script>
    <script src="/scripts/letter-river-preview.js?v=8" defer></script>
  </body>
</html>

<style is:global>
  .pv2-skip {
    position: fixed;
    left: 12px;
    top: 12px;
    z-index: 1100;
    transform: translateY(-160%);
    padding: 10px 14px;
    border-radius: 999px;
    background: #d8ff63;
    color: #15170e;
    font: 700 14px/1 system-ui, sans-serif;
  }

  .pv2-skip:focus {
    transform: translateY(0);
  }

  .pv2-overview__statement {
    position: absolute !important;
    left: 50% !important;
    top: 50% !important;
    right: auto !important;
    bottom: auto !important;
    transform: translate(-50%, -50%) !important;
  }

  @media (max-width: 720px) {
    html.pv2-physics-live .pv2-overview__statement {
      top: 50% !important;
    }

    html:not(.pv2-physics-live) .pv2-overview__statement {
      position: relative !important;
      inset: auto !important;
      transform: none !important;
    }
  }
</style>
