---
/**
 * The front door — a navigator, not a page of prose.
 *
 * The playground (`/playground`) used to be the site root, so every visitor
 * was dropped straight into a physics sim. This replaces that with one screen
 * that does a single job: pick where to go. Five destinations on a coverflow
 * arc, a word each. The playground is first because it is the headline route,
 * but nothing funnels toward it.
 */
import { portfolioV2NodeMap } from '../data/portfolioV2';
import '../styles/portfolio-v2.css';

/**
 * The five destinations.
 *
 * A card either shows a photograph (`art`) or a drawn field (`field`). The
 * field's `amb` is the mid-tone the page backdrop takes behind that card:
 * the backdrop blurs the card's artwork under a cream scrim, and handing it
 * a near-black gradient just turns the whole page grey.
 */
const destinations = [
  {
    href: '/playground',
    title: 'Playground',
    line: 'The work, floating',
    // The painting is only the backdrop the playground sits on — on its own it
    // said "landscape", not "a space with my work floating in it". The card
    // rebuilds the playground's actual composition instead: the same project
    // orbs over the same backdrop, drifting. A screenshot would have been more
    // literal, but the playground is a wide landscape and a portrait crop of
    // one loses most of the orbs and softens what is left.
    art: '/images/derived/work-backgrounds/landers-peak-900.webp',
    pos: 'center 55%',
    // Centres and diameters as a percentage of the card's width. Kept inside
    // the edges with room for the drift, and clear of the "Enter" chip.
    orbs: [
      { art: '/images/derived/oiz8uf-768.webp', x: 48, y: 23, size: 38 },
      { art: '/images/derived/letterriverscreen-768.webp', x: 17, y: 42, size: 30 },
      // The interesting half of this one is the tarot hand along the bottom;
      // a centred circular crop is just the empty green table above it.
      { art: '/images/derived/Thelastreadingscreen-768.webp', x: 76, y: 44, size: 26, pos: 'center 74%' },
      { art: '/images/derived/rotogoscreen-768.webp', x: 27, y: 66, size: 29 },
      { art: '/images/derived/VenueRivalsscreen-768.webp', x: 68, y: 72, size: 25 },
    ],
  },
  {
    href: '/playground?project=unfinished',
    title: 'Games',
    line: 'Five playable projects',
    // One band per game rather than a single key art: the Café source is only
    // 315px wide and a portrait card had to blow it up and crop its title off.
    // The stack also just says "five" without the card needing to.
    tiles: [
      '/images/derived/oiz8uf-768.webp',
      '/images/derived/letterriverscreen-768.webp',
      '/images/derived/Thelastreadingscreen-768.webp',
      '/images/derived/rotogoscreen-768.webp',
      '/images/derived/VenueRivalsscreen-768.webp',
    ],
    // Behind the arc the artwork is blurred past recognition, so one is enough.
    art: '/images/derived/oiz8uf-768.webp',
    pos: 'center',
  },
  {
    href: '/ux',
    title: 'UX',
    line: 'Product & research work',
    // Four shrunken screenshots said "four screens", not "UX". What this page
    // actually leads with is outcomes, so the card leads with them too. Every
    // figure is one the case studies already publish.
    // No photograph. The dashboard shot was a desk, a monitor and UI too small
    // to read, and dimming it far enough to carry type turned it to sludge.
    // The outcomes are the content; the ground is a drawn field behind them.
    field: { from: '#26313f', to: '#0d1219', pattern: 'grid', amb: '#6d8099' },
    metrics: [
      { value: '8h → 37min', label: 'Document processing, IDL' },
      { value: '+30%', label: 'Daily habits, Earth Hero' },
      { value: '5h a week', label: 'Per researcher, AI Archiving' },
    ],
  },
  {
    href: '/research',
    title: 'Research',
    line: 'The open question',
    // The Café gameplay loop — the build the study is actually about — with
    // the page's own evidence ladder over it. The derivative is an animated
    // WebP, so the card plays the thing being studied.
    field: { from: '#213934', to: '#0a1413', pattern: 'scatter', amb: '#71937f' },
    // The evidence ladder needed four labels to say what the page's own
    // heading says in one line. The question is the page; the status is the
    // page being honest that nothing has been measured yet.
    question: 'Can interaction help to interpret a lived experience?',
    status: 'Study in design · no data yet',
  },
  {
    href: '/contact',
    title: 'Contact',
    line: 'Say hello',
    // The only destination with no artifact of its own to show. A loose
    // seaside painting behind a crisp white form read as stock art, so the
    // form gets a quiet field to sit on instead.
    field: { from: '#2c2824', to: '#13100e', pattern: 'glow', amb: '#a08e7a' },
    form: true,
  },
];

// Named here only so the description stays true if the roster changes.
const playableCount = ['get-to-the-cafe', 'letter-river', 'last-reading', 'rotogo', 'gig-duel']
  .filter((id) => portfolioV2NodeMap.has(id)).length;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`Jacob Meyerkopf — interactive designer. ${playableCount} playable projects, a physics playground, UX and research work.`}
    />
    <title>Jacob Meyerkopf — Interactive Designer</title>
    <link rel="preload" as="image" href={destinations[0].art} />
    <script is:inline>
      // `/?project=x` was the shareable deep link while the playground lived at
      // the root. Those URLs are in the wild, so forward them rather than
      // showing a navigator that has no use for the parameter. `replace`, not
      // `assign`: the door must not become a back-button trap.
      (() => {
        if (!new URLSearchParams(window.location.search).has('project')) return;
        window.location.replace('/playground' + window.location.search + window.location.hash);
      })();
    </script>
  </head>
  <body class="pv2-body entry-body">
    <div class="entry__amb" aria-hidden="true">
      <span data-amb></span><span data-amb></span>
    </div>

    <main class="entry">
      <header class="entry__bar">
        <strong>Jacob Meyerkopf</strong>
        <span>Interactive designer</span>
      </header>

      <div class="entry__stage" data-stage>
        <ul class="entry__rail" data-rail>
          {destinations.map((d, i) => (
            <li
              class="entry__slot"
              data-ambient={d.field
                ? `linear-gradient(150deg, ${d.field.amb}, ${d.field.from})`
                : `url('${d.art}')`}
            >
              <a
                class={`dcard${d.field ? ' dcard--field' : ''}`}
                href={d.href}
                data-card
                style={`--art: url('${d.art}'); --art-pos: ${d.pos}`}
              >
                {d.tiles && (
                  <span class="dcard__art dcard__art--stack" aria-hidden="true">
                    {d.tiles.map((tile) => <span style={`--art: url('${tile}')`} />)}
                  </span>
                )}
                {d.orbs && (
                  <span class="dcard__art dcard__art--play" aria-hidden="true">
                    {d.orbs.map((orb, j) => (
                      <span
                        class="dcard__orb"
                        style={`--art: url('${orb.art}'); --x: ${orb.x}%; --y: ${orb.y}%; --size: ${orb.size}%; --drift: ${j}; --orb-pos: ${orb.pos ?? 'center'}`}
                      />
                    ))}
                  </span>
                )}
                {d.field && (
                  <span
                    class={`dcard__art dcard__art--field dcard__art--${d.field.pattern}`}
                    style={`--f1: ${d.field.from}; --f2: ${d.field.to}`}
                    aria-hidden="true"
                  />
                )}
                {!d.tiles && !d.orbs && !d.field && <span class="dcard__art" aria-hidden="true" />}
                {d.metrics && (
                  <span class="dcard__metrics" aria-hidden="true">
                    {d.metrics.map((metric) => (
                      <span>
                        <strong>{metric.value}</strong>
                        <em>{metric.label}</em>
                      </span>
                    ))}
                  </span>
                )}
                {d.question && (
                  <span class="dcard__ask" aria-hidden="true">
                    <span class="dcard__ask-mark">?</span>
                    <span class="dcard__ask-text">{d.question}</span>
                    {d.status && <span class="dcard__ask-status">{d.status}</span>}
                  </span>
                )}
                {d.form && (
                  <span class="dcard__form" aria-hidden="true">
                    <span class="dcard__field" /><span class="dcard__field" />
                    <span class="dcard__field dcard__field--tall" />
                    <span class="dcard__send">Send</span>
                  </span>
                )}
                <span class="dcard__veil" aria-hidden="true" />
                <span class="dcard__text">
                  <strong>{d.title}</strong>
                  <em>{d.line}</em>
                </span>
                <span class="dcard__enter" aria-hidden="true">Enter →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav class="entry__dots" aria-label="Choose a destination" data-dots>
        {destinations.map((d, i) => (
          <button type="button" data-dot={i} aria-label={d.title}><span /></button>
        ))}
      </nav>

      <p class="entry__hint" aria-hidden="true">
        <span class="entry__hint-pointer">Drag &middot; scroll &middot; <kbd>←</kbd> <kbd>→</kbd></span>
        <span class="entry__hint-touch">Swipe to choose</span>
      </p>
    </main>

    <script is:inline>
      (() => {
        const stage = document.querySelector('[data-stage]');
        const rail = document.querySelector('[data-rail]');
        if (!stage || !rail) return;

        const slots = Array.from(rail.children);
        const cards = slots.map((slot) => slot.querySelector('[data-card]'));
        const dots = Array.from(document.querySelectorAll('[data-dot]'));
        const ambient = Array.from(document.querySelectorAll('[data-amb]'));
        const n = slots.length;

        // Without JS the rail is a plain scroll-snap row, which is a working
        // navigation on its own. The arc is the enhancement, so it is only
        // switched on once the code that drives it is running.
        stage.classList.add('is-live');

        // `active` is unbounded and the ring is read modulo the card count, so
        // the fan is always two cards deep on both sides. Clamping at the ends
        // instead left the first and last card sitting against a bare half of
        // the stage, which read as a layout fault rather than an edge.
        let active = 0;
        let ambientLayer = 0;

        const index = () => ((active % n) + n) % n;

        function layout() {
          const here = index();
          slots.forEach((slot, i) => {
            let offset = (((i - here) % n) + n) % n;
            if (offset > n / 2) offset -= n;
            const far = Math.abs(offset);
            slot.style.setProperty('--offset', String(offset));
            slot.style.setProperty('--far', String(far));
            slot.style.zIndex = String(n - far);
            cards[i].classList.toggle('is-active', offset === 0);
            cards[i].tabIndex = offset === 0 ? 0 : -1;
          });
          dots.forEach((dot, i) => dot.setAttribute('aria-current', i === here ? 'true' : 'false'));

          // Crossfade the front card's artwork into the page behind it, so the
          // whole screen belongs to whatever is being considered. Two layers,
          // alternating, because repainting one would blink on the swap.
          if (ambient.length === 2) {
            // A photographic card hands over its image; a drawn card hands
            // over its gradient. Either way it is blurred past recognition
            // and only the colour survives.
            const art = slots[here].dataset.ambient;
            const next = ambient[ambientLayer ^ 1];
            if (next.dataset.ambient !== art) {
              next.style.backgroundImage = art;
              next.dataset.ambient = art;
            }
            ambientLayer ^= 1;
            ambient.forEach((layer, i) => layer.classList.toggle('is-on', i === ambientLayer));
          }
        }

        function go(next) {
          if (next === active) return;
          active = next;
          layout();
        }

        layout();

        dots.forEach((dot, i) => dot.addEventListener('click', () => {
          // Step to the nearest copy of that card on the ring rather than its
          // raw index, so the arc turns the short way round.
          let delta = (((i - index()) % n) + n) % n;
          if (delta > n / 2) delta -= n;
          go(active + delta);
          cards[i].focus();
        }));

        const stepTo = (i) => {
          let delta = (((i - index()) % n) + n) % n;
          if (delta > n / 2) delta -= n;
          go(active + delta);
        };

        // Which card was in front when the press started. Pressing a card also
        // focuses it, and the focus handler below brings it forward, so by the
        // time its click fires it is already the front card — reading `index()`
        // there made every side card follow its link on the first click.
        // `null` means no pointer was involved (Enter on a focused card), which
        // is always a deliberate go.
        let pressedFront = null;
        stage.addEventListener('pointerdown', () => { pressedFront = index(); });

        cards.forEach((card, i) => {
          card.addEventListener('click', (event) => {
            const wasFront = pressedFront === null || pressedFront === i;
            pressedFront = null;
            if (wasFront) return;
            // A card off to the side is a target to bring forward, not a link
            // to follow: a glancing click on a steeply angled sliver should
            // never navigate somewhere the visitor never actually looked at.
            event.preventDefault();
            stepTo(i);
            card.focus();
          });
          // Tabbing or a screen reader moving through the rail should bring the
          // card it lands on to the front, so focus and the arc never disagree.
          card.addEventListener('focus', () => stepTo(i));
        });

        document.addEventListener('keydown', (event) => {
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          event.preventDefault();
          go(active + step);
          cards[index()].focus();
        });

        // One notch of a wheel or trackpad flick per card. Without the cooldown
        // a single trackpad swipe emits dozens of events and throws the rail to
        // the far end.
        let wheelLock = 0;
        stage.addEventListener('wheel', (event) => {
          const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
          if (Math.abs(delta) < 8) return;
          event.preventDefault();
          const now = event.timeStamp;
          if (now - wheelLock < 320) return;
          wheelLock = now;
          go(active + Math.sign(delta));
        }, { passive: false });

        // Drag. Tracked on the stage rather than the card, so a gesture that
        // starts on one card and ends over another still counts.
        let startX = null;
        let startIndex = 0;
        let dragged = false;

        stage.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          startX = event.clientX;
          startIndex = active;
          dragged = false;
        });

        stage.addEventListener('pointermove', (event) => {
          if (startX === null) return;
          const travel = event.clientX - startX;
          if (Math.abs(travel) <= 8) return;
          if (!dragged) {
            dragged = true;
            // Captured only now, not on pointerdown. Capture retargets the
            // click that pointerup synthesises to the capturing element, so
            // taking it up front meant no card ever received its own click and
            // none of the links could be followed at all.
            stage.setPointerCapture(event.pointerId);
          }
          // One card per ~22% of the stage, so the gesture feels the same on a
          // phone and on a wide desktop.
          const perCard = Math.max(90, stage.clientWidth * 0.22);
          go(startIndex - Math.round(travel / perCard));
        });

        const endDrag = (event) => {
          if (startX === null) return;
          startX = null;
          if (stage.hasPointerCapture?.(event.pointerId)) stage.releasePointerCapture(event.pointerId);
        };
        stage.addEventListener('pointerup', endDrag);
        stage.addEventListener('pointercancel', endDrag);
        stage.addEventListener('click', (event) => {
          if (dragged) {
            event.preventDefault();
            event.stopPropagation();
            dragged = false;
          }
        }, true);

        // Pointer parallax on the whole arc. Purely atmospheric, and only where
        // a real pointer and motion are both welcome.
        if (matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
          stage.addEventListener('pointermove', (event) => {
            const rect = stage.getBoundingClientRect();
            rail.style.setProperty('--tilt-y', ((event.clientX - rect.left) / rect.width - 0.5).toFixed(3));
            rail.style.setProperty('--tilt-x', ((event.clientY - rect.top) / rect.height - 0.5).toFixed(3));
          });
          stage.addEventListener('pointerleave', () => {
            rail.style.setProperty('--tilt-y', '0');
            rail.style.setProperty('--tilt-x', '0');
          });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  .entry-body {
    overflow: hidden;
    /* The navigator is one screen. Nothing below it, so nothing to scroll to. */
    height: 100svh;
  }

  .entry {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    height: 100svh;
    padding: clamp(16px, 2.4vh, 26px) clamp(16px, 3.4vw, 46px) clamp(18px, 3vh, 30px);
  }

  .entry__bar {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }

  .entry__bar strong {
    font-size: clamp(.95rem, 1.1vw, 1.04rem);
    font-weight: 650;
    letter-spacing: -.01em;
  }

  .entry__bar span {
    color: var(--pv2-muted);
    font-size: clamp(.78rem, .9vw, .86rem);
  }

  /* The front card's artwork, blown up and blurred behind everything. It is
     the only colour on the screen, so the door takes its mood from whichever
     destination is being considered. */
  .entry__amb {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--pv2-bg);
  }

  .entry__amb span {
    position: absolute;
    inset: -14%;
    background-position: center;
    background-size: cover;
    filter: blur(68px) saturate(1.1);
    opacity: 0;
    transform: scale(1.18);
    transition: opacity 780ms var(--pv2-ease);
  }

  .entry__amb span.is-on { opacity: .66; }

  /* A cream wash over the blur, so the card edges and the dark type on the
     chrome keep their contrast whatever painting is behind them. */
  .entry__amb::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(128% 90% at 50% 44%, rgba(247, 246, 242, .1) 0%, rgba(247, 246, 242, .6) 52%, rgba(247, 246, 242, .92) 100%);
  }

  /* --- Stage ------------------------------------------------------------ */

  .entry__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    perspective: 1500px;
    perspective-origin: 50% 46%;
  }

  .is-live.entry__stage {
    touch-action: pan-y;
    cursor: grab;
  }

  .is-live.entry__stage:active { cursor: grabbing; }

  .entry__rail {
    display: flex;
    gap: 16px;
    align-items: center;
    margin: 0;
    padding: 0 max(16px, 50% - 170px);
    list-style: none;
    max-width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .entry__rail::-webkit-scrollbar { display: none; }

  .entry__slot {
    scroll-snap-align: center;
    /* On the flat row a card is `width: 100%` of its slot, so the slot's
       min-content size is zero and the flex line squeezes all five into
       slivers. Fixed basis, no shrink. */
    flex: 0 0 auto;
  }

  /* The arc, switched on only once its script is running. */
  .is-live .entry__rail {
    position: absolute;
    inset: 0;
    display: block;
    padding: 0;
    overflow: visible;
    transform-style: preserve-3d;
    transform:
      rotateY(calc(var(--tilt-y, 0) * 5deg))
      rotateX(calc(var(--tilt-x, 0) * -4deg));
    transition: transform 420ms var(--pv2-ease);
    /* The rail fills the stage at z = 0, and every card but the front one is
       pushed behind that plane, so the rail won hit-testing for all of them
       and only the front card could be clicked. It is a positioning frame, not
       a target: the drag listeners live on the stage, so it can step aside. */
    pointer-events: none;
  }

  .is-live .entry__slot {
    position: absolute;
    left: 50%;
    top: 50%;
    /* Sized off the short axis as well as the wide one: on a laptop the stage
       has far more height than a 20vw card was using. */
    width: clamp(190px, min(26vw, 40svh), 380px);
    transform-style: preserve-3d;
    transform:
      translate(-50%, -50%)
      translateX(calc(var(--offset) * clamp(104px, min(14vw, 22svh), 214px)))
      translateZ(calc(var(--far) * -165px))
      rotateY(calc(var(--offset) * -27deg))
      scale(calc(1 - var(--far) * .05));
    opacity: calc(1 - var(--far) * .26);
    pointer-events: auto;
    transition:
      transform 520ms var(--pv2-ease-major),
      opacity 420ms var(--pv2-ease);
  }

  /* --- Card ------------------------------------------------------------- */

  .dcard {
    position: relative;
    display: block;
    width: clamp(190px, min(26vw, 40svh), 380px);
    aspect-ratio: 3 / 4.1;
    border-radius: 18px;
    overflow: hidden;
    background: var(--pv2-soft);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 18px 44px rgba(26, 24, 20, .28);
    transition: box-shadow 420ms var(--pv2-ease);
  }

  .is-live .dcard { width: 100%; }

  .dcard__art {
    position: absolute;
    inset: 0;
    background-image: var(--art);
    background-position: var(--art-pos, center);
    background-size: cover;
    transform: scale(1.06);
    filter: saturate(.86) brightness(.94);
    transition: transform 620ms var(--pv2-ease-major), filter 420ms var(--pv2-ease);
  }

  .dcard__art--stack {
    display: grid;
    grid-template-rows: repeat(5, 1fr);
    gap: 2px;
    background: none;
  }

  .dcard__art--stack > span {
    background: var(--art) center / cover no-repeat;
  }

  /* The playground's own composition, rebuilt: project orbs over the backdrop
     the real page paints behind them. */
  .dcard__art--play {
    background-image: var(--art);
    background-position: var(--art-pos, center);
    background-size: cover;
    /* The 6% overscan the other cards use to hide a zoom seam would push the
       outer orbs past the card's edge and crop them. This layer is composed to
       the card, so it sits flush. */
    transform: none;
  }

  .dcard__orb {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--art) var(--orb-pos, center) / cover no-repeat;
    transform: translate(-50%, -50%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 252, 244, .5),
      inset 0 8px 14px rgba(255, 255, 255, .18),
      0 7px 16px rgba(26, 24, 20, .34);
  }

  /* Only the card in front drifts: the rest are slivers at a steep angle where
     the motion would read as jitter, and five animations each would be paid
     for on a card nobody can see. */
  @media (prefers-reduced-motion: no-preference) {
    .dcard.is-active .dcard__orb {
      animation: dcard-drift calc(6.5s + var(--drift) * 1.4s) var(--pv2-ease) infinite alternate;
      animation-delay: calc(var(--drift) * -1.9s);
    }
  }

  @keyframes dcard-drift {
    from { transform: translate(-50%, -50%); }
    to { transform: translate(calc(-50% + 4px), calc(-50% - 7px)); }
  }

  /* Drawn grounds for the three cards whose subject is type. A photograph
     under a panel had to be dimmed so far to carry the type that it became
     sludge, and a desk, a monitor and a loose seaside painting were not
     showing anything the page actually contains. Each field is a graded
     wash plus one quiet pattern that belongs to its page. */
  .dcard__art--field {
    transform: none;
    background-image:
      radial-gradient(118% 86% at 26% 8%, color-mix(in oklab, var(--f1) 78%, white) 0%, transparent 56%),
      linear-gradient(152deg, var(--f1) 0%, var(--f2) 86%);
  }

  /* Service blueprints and flows: a drafting grid. */
  .dcard__art--grid::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: .4;
    background-image:
