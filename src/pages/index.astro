---
import RelationalPortfolio from '../components/RelationalPortfolio.jsx';
import '../styles/portfolio-v2-overrides.css';
import '../styles/portfolio-v2-adaptive.css';
import '../styles/portfolio-loading.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Interactive work by Jacob Meyerkopf: games, disability experiences, learning systems, unfinished experiments, and UX work."
    />
    <title>Jacob Meyerkopf — Interactive Work</title>
  </head>
  <body class="pv2-body">
    <a class="pv2-skip" href="#portfolio-v2">Skip to work</a>
    <div class="pv2-boot-loader" aria-label="Loading portfolio" role="status">
      <div class="pv2-loader-dots" aria-hidden="true"><span></span><span></span><span></span></div>
    </div>
    <div id="portfolio-v2">
      <RelationalPortfolio client:load />
    </div>
    <script is:inline>
      (() => {
        const loader = document.querySelector('.pv2-boot-loader');
        if (!loader) return;

        const finish = () => {
          if (!loader.isConnected) return;
          loader.classList.add('is-done');
          window.setTimeout(() => loader.remove(), 220);
        };

        const waitForPortfolio = () => {
          if (document.querySelector('#portfolio-v2 .pv2-site')) {
            requestAnimationFrame(() => requestAnimationFrame(finish));
            return;
          }
          requestAnimationFrame(waitForPortfolio);
        };

        waitForPortfolio();
        window.setTimeout(finish, 5000);
      })();
    </script>
    <script src="/scripts/portfolio-physics-v3.js?v=9" defer></script>
    <script src="/scripts/portfolio-scroll-drift.js?v=5" defer></script>
    <script src="/scripts/ux-direct-link.js?v=1" defer></script>
    <script src="/scripts/portfolio-bio-bounce.js?v=3" defer></script>
    <script src="/scripts/letter-river-preview.js?v=4" defer></script>
  </body>
</html>

<style is:global>
  .pv2-skip {
    position: fixed;
    left: 12px;
    top: 12px;
    z-index: 1100;
    transform: translateY(-160%);
    padding: 10px 14px;
    border-radius: 999px;
    background: #d8ff63;
    color: #15170e;
    font: 700 14px/1 system-ui, sans-serif;
  }

  .pv2-skip:focus {
    transform: translateY(0);
  }
</style>