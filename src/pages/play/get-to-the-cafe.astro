---
const gameSrc = '/games/get-to-the-cafe/index.html';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Play Get to the Café in the browser." />
    <title>Play Get to the Café</title>
  </head>
  <body>
    <header class="playbar">
      <a href="/v2?project=get-to-the-cafe">← Back to project</a>
      <strong>Get to the Café</strong>
      <button id="fullscreen" type="button">Fullscreen</button>
    </header>

    <main class="game-shell" id="game-shell">
      <iframe
        id="game-frame"
        src={gameSrc}
        title="Get to the Café"
        allow="autoplay; fullscreen; gamepad"
        allowfullscreen
      ></iframe>
    </main>

    <script is:inline>
      const fullscreenButton = document.getElementById('fullscreen');
      const gameShell = document.getElementById('game-shell');

      fullscreenButton?.addEventListener('click', async () => {
        try {
          if (!document.fullscreenElement) {
            await gameShell?.requestFullscreen();
          } else {
            await document.exitFullscreen();
          }
        } catch (error) {
          console.warn('Fullscreen request was not available.', error);
        }
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html, body) {
    margin: 0;
    width: 100%;
    height: 100%;
    background: #111;
    color: #f7f6f2;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :global(body) {
    display: grid;
    grid-template-rows: 56px minmax(0, 1fr);
    overflow: hidden;
  }

  .playbar {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 0 18px;
    background: rgba(17, 17, 17, 0.94);
    border-bottom: 1px solid rgba(255,255,255,.12);
    backdrop-filter: blur(12px);
  }

  .playbar a,
  .playbar button {
    color: inherit;
    font: inherit;
  }

  .playbar a {
    justify-self: start;
    text-decoration: none;
    opacity: .72;
  }

  .playbar strong {
    font-size: .9rem;
    font-weight: 650;
  }

  .playbar button {
    justify-self: end;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .playbar a:hover,
  .playbar button:hover { opacity: 1; }

  .game-shell {
    min-width: 0;
    min-height: 0;
    background: #000;
  }

  .game-shell iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }

  .game-shell:fullscreen {
    width: 100vw;
    height: 100vh;
  }

  @media (max-width: 640px) {
    :global(body) { grid-template-rows: 52px minmax(0, 1fr); }
    .playbar {
      grid-template-columns: 1fr auto;
      padding-inline: 12px;
    }
    .playbar strong { display: none; }
  }
</style>
