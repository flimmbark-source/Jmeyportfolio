---
const { media } = Astro.props;
// A photograph can be cropped to fit its box. A page of text cannot: cropping
// the test plan cut 23% of its height and chopped the methodology mid-line.
const isDoc = media?.fit === 'contain' || media?.kind === 'document';
const isImage = media?.type === 'image';
const isVideo = media?.type === 'video';
const isEmbed = media?.type === 'embed';
---
{media && (
  <figure class={`case-media mt-10 overflow-hidden${isDoc ? ' case-media--doc' : ''}`}>
    {isImage && (
      <img
        src={media.src}
        alt={media.alt ?? media.title ?? 'Illustration of the project work'}
        class="case-media__img"
        loading="lazy"
        decoding="async"
      />
    )}
    {isVideo && (
      <video class="h-full w-full" controls poster={media.poster}>
        <source src={media.src} type={media.mimeType ?? 'video/mp4'} />
        Your browser does not support the video tag.
      </video>
    )}
    {isEmbed && (
      <div class="aspect-video w-full">
        <iframe
          src={media.src}
          title={media.title ?? 'Embedded media'}
          class="h-full w-full"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    )}
    {media.title && <figcaption class="case-media__caption">{media.title}</figcaption>}
  </figure>
)}
