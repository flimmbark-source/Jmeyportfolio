---
const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
const alignment = align === 'center' ? 'text-center' : 'text-left';
---
<header class={`max-w-3xl ${alignment}`}>
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-600 dark:text-brand-300">
      {eyebrow}
    </p>
  )}
  {title && (
    <h2 class="mt-3 text-3xl font-bold text-slate-900 sm:text-4xl dark:text-white">{title}</h2>
  )}
  {subtitle && <p class="mt-4 text-lg leading-relaxed text-slate-700 dark:text-slate-200">{subtitle}</p>}
</header>
