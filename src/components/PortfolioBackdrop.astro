---
import { workBackgrounds } from '../data/workBackgrounds';

interface Props {
  credit?: boolean;
}

const { credit = true } = Astro.props;
const backgrounds = workBackgrounds.map(({ src, position }) => ({ src, position }));
---

<div
  class="pv2-page-backdrop"
  data-backgrounds={JSON.stringify(backgrounds)}
  aria-hidden="true"
>
  <div class="pv2-page-backdrop__art"></div>
  <div class="pv2-page-backdrop__scrim"></div>
</div>

{credit && (
  <p class="pv2-page-backdrop-credit">
    Images supplied by The Met Open Access Collection. All Images are Public Domain.
  </p>
)}

<script>
  (() => {
    const backdrops = document.querySelectorAll('.pv2-page-backdrop[data-backgrounds]:not([data-ready])');

    backdrops.forEach((backdrop) => {
      backdrop.setAttribute('data-ready', 'true');

      let backgrounds = [];
      try {
        backgrounds = JSON.parse(backdrop.getAttribute('data-backgrounds') || '[]');
      } catch {
        return;
      }

      if (!backgrounds.length) return;

      const choice = backgrounds[Math.floor(Math.random() * backgrounds.length)];
      const art = backdrop.querySelector('.pv2-page-backdrop__art');
      if (!(art instanceof HTMLElement)) return;

      const image = new Image();
      image.decoding = 'async';
      image.onload = () => {
        art.style.backgroundImage = `url("${choice.src}")`;
        art.style.backgroundPosition = choice.position;
        backdrop.classList.add('is-ready');
      };
      image.src = choice.src;
    });
  })();
</script>
