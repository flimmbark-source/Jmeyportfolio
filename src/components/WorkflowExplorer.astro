---
const stages = [
  { id: 'information', label: 'Prepare information', note: 'Make the input easier to use.', title: 'The drawing starts before SolidWorks.', body: 'I collaborated with other parts of the team to encode information more efficiently. Improving the input supported quicker handoffs into the next part of the work.', connection: 'Information preparation and handoffs were connected parts of the improvement.' },
  { id: 'drawing', label: 'Produce drawings', note: 'Combine knowledge of the tool.', title: 'Good shortcuts came from more than one person.', body: 'I combined my understanding of SolidWorks and its time-saving features with shortcuts my coworkers knew. We learned from one another while improving the drawing process.', connection: 'Software knowledge became more useful when we exchanged it.' },
  { id: 'handoff', label: 'Hand work over', note: 'Help information move between people.', title: 'Look beyond the task at your own desk.', body: 'Working with other parts of the team helped us prepare information for quicker handoffs. The improvement involved how work moved between people, as well as how I produced drawings.', connection: 'A local improvement should support the next person in the process.' },
  { id: 'quality', label: 'Check quality', note: 'Include QC in the workflow.', title: 'Quality checking was part of the process to improve.', body: 'Streamlining QC was another part of the work, alongside software efficiencies, information preparation, and handoffs. I considered the process beyond the drawing task itself.', connection: 'The reported turnaround figures cover the combined improvements, not a separate saving attributed to QC.' },
  { id: 'sharing', label: 'Share discoveries across the team', note: 'Learning connected every stage.', title: 'Sharing discoveries deepened cooperation.', body: 'I shared what I discovered, learned shortcuts from coworkers, and worked with other parts of the team. That exchange allowed us to cooperate more deeply as we improved the process.', connection: 'The two-hour result was a team achievement. The later 37-minute result describes my further individual refinement.' },
];
---
<section class="workflow" aria-labelledby="workflow-title" data-workflow>
  <div class="workflow-heading"><div><p class="uxw-label">Inside the improvement</p><h4 id="workflow-title">Change the connections,<br />not just the task.</h4></div><p>A simplified account of the workflow.<br /><span data-workflow-instruction hidden>Select a stage to see what changed.</span></p></div>
  <div class="workflow-controls" data-workflow-controls hidden>
    <div class="workflow-stages" role="group" aria-label="Explore workflow stages">
      {stages.slice(0, 4).map((stage, index) => <button type="button" data-stage={stage.id} aria-controls={`workflow-${stage.id}`} aria-pressed={index === 0 ? 'true' : 'false'}><span class="workflow-number" aria-hidden="true">0{index + 1}</span><strong>{stage.label}</strong><span>{stage.note}</span></button>)}
    </div>
    <button class="workflow-sharing" type="button" data-stage="sharing" aria-controls="workflow-sharing" aria-pressed="false"><span aria-hidden="true">↔</span><strong>Share discoveries across the team</strong><span>Learning connected every stage</span></button>
    <button class="workflow-all" type="button" data-workflow-all aria-pressed="false">Show all explanations</button>
  </div>
  <div class="workflow-panels" aria-live="polite" aria-atomic="false">
    {stages.map((stage, index) => <section class="workflow-panel" id={`workflow-${stage.id}`} data-panel={stage.id} aria-labelledby={`workflow-heading-${stage.id}`}><p class="uxw-label">{index < 4 ? `0${index + 1} / ${stage.label}` : 'Across the process'}</p><h5 id={`workflow-heading-${stage.id}`}>{stage.title}</h5><p>{stage.body}</p><p class="workflow-connection">{stage.connection}</p></section>)}
  </div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-workflow]');
  if (root) {
    const controls = root.querySelector<HTMLElement>('[data-workflow-controls]')!;
    const instruction = root.querySelector<HTMLElement>('[data-workflow-instruction]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-stage]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const all = root.querySelector<HTMLButtonElement>('[data-workflow-all]')!;
    let selected = 'information';
    let expanded = false;
    const render = () => {
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.stage === selected)));
      panels.forEach(panel => { panel.hidden = !expanded && panel.dataset.panel !== selected; });
      all.setAttribute('aria-pressed', String(expanded));
      all.textContent = expanded ? 'Show selected explanation' : 'Show all explanations';
    };
    buttons.forEach(button => button.addEventListener('click', () => {
      selected = button.dataset.stage!;
      expanded = false;
      render();
    }));
    all.addEventListener('click', () => { expanded = !expanded; render(); });
    render();
    controls.hidden = false;
    instruction.hidden = false;
  }
</script>
<style>
  .workflow { margin: 32px 0 0; border: 1px solid var(--pv2-line); border-radius: 12px; padding: clamp(20px, 3vw, 32px); background: #fff8; }
  .workflow [hidden] { display: none !important; }
  .workflow-heading { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 24px; }
  h4 { margin: 10px 0 0; font-family: var(--pv2-font-display); font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height: 1.15; }
  .workflow-heading > p { margin: 0; font-size: .9rem; color: var(--pv2-muted); }
  .workflow-stages { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  button { cursor: pointer; color: var(--pv2-text); font: inherit; }
  button:focus-visible { outline: 3px solid var(--pv2-accent); outline-offset: 4px; }
  .workflow-stages button { display: flex; flex-direction: column; text-align: left; gap: 8px; padding: 18px; background: var(--pv2-bg); border: 1px solid var(--pv2-line); border-radius: 6px; }
  .workflow-stages button:hover { border-color: var(--pv2-accent); }
  .workflow-stages button[aria-pressed=true] { background: #e1e9df; border-color: #405b44; box-shadow: inset 0 -3px #405b44; }
  .workflow-number { color: var(--pv2-muted); font-size: .75rem; }
  .workflow-stages strong { line-height: 1.3; font-weight: 650; }
  .workflow-stages button > span:last-child { font-size: .85rem; line-height: 1.4; }
  .workflow-sharing { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px 16px; width: 100%; margin-top: 12px; padding: 14px 18px; border: 1px solid #c4cdbf; background: #e9ede5; border-radius: 6px; }
  .workflow-sharing[aria-pressed=true] { border-color: #405b44; box-shadow: inset 0 -3px #405b44; }
  .workflow-sharing > span:last-child { font-size: .85rem; }
  .workflow-all { display: block; margin: 8px 0 0 auto; min-height: 44px; padding: 8px 0; background: transparent; border: 0; text-decoration: underline; text-underline-offset: 4px; font-size: .9rem; }
  .workflow-panels { min-height: 250px; }
  .workflow-panel { padding: 24px 0 0; border-top: 1px solid var(--pv2-line); }
  .workflow-panel + .workflow-panel { margin-top: 24px; }
  h5 { font-family: var(--pv2-font-display); font-size: clamp(1.4rem, 2vw, 1.8rem); line-height: 1.2; margin: 10px 0 14px; }
  .workflow-panel > p { max-width: 76ch; }
  .workflow-connection { border-left: 3px solid #405b44; padding-left: 16px; color: var(--pv2-muted); font-size: .9rem; }
  @media (max-width: 760px) {
    .workflow-heading { display: block; }
    .workflow-heading > p { margin-top: 16px; }
    .workflow-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .workflow-stages button { padding: 12px; }
    .workflow-sharing { justify-content: start; text-align: left; }
    .workflow-panels { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .workflow * { scroll-behavior: auto; } }
</style>
